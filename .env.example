# Copie para .env e ajuste. O .env nunca vai para o git.

# --- Aplicação ---
DEBUG=true
HOST=127.0.0.1
PORT=8000
BASE_URL=http://127.0.0.1:8000

# --- Segurança ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-este-valor-em-producao

# --- Banco de dados ---
# Local (padrão): SQLite, sem nenhuma configuração extra.
DATABASE_URL=sqlite:///./storybook.db
# Na VPS, troque pela linha abaixo (e instale psycopg no requirements.txt):
# DATABASE_URL=postgresql+psycopg://storybook:senha-forte@localhost:5432/storybook

# --- Uploads ---
MAX_UPLOAD_MB=8

# --- Cadastro ---
ALLOW_PUBLIC_SIGNUP=true
